{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (unoptimised, smoke tests on)",
      "description": "Debug build of the library plus the ChrononMotion smoke test.",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONONMOTION_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-fast",
      "inherits": "dev",
      "displayName": "Development, cached and linked fast",
      "description": "`dev` with ccache, mold and Ninja. Needs ccache and mold on PATH; the build preset uses 16 jobs, so budget roughly 16 GB of RAM.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-fast",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "release",
      "displayName": "Release (warnings as errors)",
      "description": "Optimised build with -Wall -Wextra -Werror, the gate a change must pass.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONONMOTION_BUILD_TESTS": "ON",
        "CHRONONMOTION_WERROR": "ON"
      }
    },
    {
      "name": "release-fast",
      "inherits": "release",
      "displayName": "Release, cached and linked fast (the gate, fast)",
      "description": "`release` with ccache, mold and Ninja: same -Wall -Wextra -Werror gate, warm-cache rebuilds in seconds. Needs ccache and mold on PATH; the build preset uses 16 jobs, so budget roughly 16 GB of RAM.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-fast",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "windows-core",
      "displayName": "Windows core library",
      "description": "MSVC Release build of the dependency-free ChrononMotion core.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build/windows-core",
      "cacheVariables": {
        "CHRONONMOTION_BUILD_TESTS": "OFF",
        "CHRONONMOTION_BUILD_RENDER": "OFF"
      }
    },
    {
      "name": "windows-gpu-adapter",
      "inherits": "windows-core",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "displayName": "Windows Chronon3D RenderPlan adapter",
      "description": "MSVC authoring tools and RenderPlan adapter for the sibling Windows GPU build.",
      "binaryDir": "${sourceDir}/build/windows-gpu-adapter",
      "cacheVariables": {
        "CHRONON3D_INCLUDE_DIR": "${sourceDir}/../Chronon3d-mainfix/include",
        "CHRONON3D_DEPENDENCY_INCLUDE_DIR": "${sourceDir}/../Chronon3d-mainfix/vcpkg_installed/win-gpu/x64-windows/include",
        "CMAKE_PREFIX_PATH": "${sourceDir}/../Chronon3d-mainfix/vcpkg_installed/win-gpu/x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "jobs": 16
    },
    {
      "name": "release-fast",
      "configurePreset": "release-fast",
      "jobs": 16
    },
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "configuration": "Release",
      "targets": ["chrononmotion"],
      "jobs": 8
    },
    {
      "name": "windows-gpu-adapter",
      "configurePreset": "windows-gpu-adapter",
      "configuration": "Release",
      "targets": ["chrononmotion_plan_optical_studio"],
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-fast",
      "configurePreset": "dev-fast",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-fast",
      "configurePreset": "release-fast",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
